<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Tisilia.Contract.Tests</RootNamespace>
    <!-- DocumentationTests read the ids the compiler writes into this file -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- drives Tisilia's source generator over sources the tests write (ResponseInferenceGeneratorTests) -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\Tisilia.Explorer\Tisilia.Explorer.csproj" />
    <ProjectReference Include="..\..\src\backend\Tisilia.Generator\Tisilia.Generator.csproj" />
    <!-- the additional codecs: registrations and the converters Tisilia ships (AdditionalCodecTests) -->
    <ProjectReference Include="..\..\src\backend\Tisilia.AspNetCore\Tisilia.AspNetCore.csproj" />
    <!-- the CLI commands (init) -->
    <ProjectReference Include="..\..\src\backend\Tisilia.Tool\Tisilia.Tool.csproj" />
    <!-- a controller host with ICU, started by MvcFormCultureTests -->
    <ProjectReference Include="..\Tisilia.CultureOracle\Tisilia.CultureOracle.csproj" />
    <!-- the source generator, and endpoints compiled with it as their analyzer (ResponseInferenceTests) -->
    <ProjectReference Include="..\..\src\backend\Tisilia.AspNetCore.SourceGenerator\Tisilia.AspNetCore.SourceGenerator.csproj" />
    <ProjectReference Include="..\Tisilia.InferenceFixture\Tisilia.InferenceFixture.csproj" />
  </ItemGroup>

</Project>
