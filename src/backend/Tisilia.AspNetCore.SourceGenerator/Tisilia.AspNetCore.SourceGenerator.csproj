<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The source generator Kkdev92.Tisilia.AspNetCore carries in analyzers/dotnet/cs. It reads the handlers of the operations a
    project registers with Tisilia and records the responses they return, which the exporter uses for an endpoint that declares
    none (Results.Ok(value), an IActionResult action returning Ok(value)).

    The compiler loads it, so it targets netstandard2.0 and compiles against the compiler's API at the oldest version a .NET 10
    SDK runs in: Microsoft.CodeAnalysis 4.14.0, Visual Studio 17.14 (learn.microsoft.com, ".NET SDK, MSBuild, and Visual Studio
    versioning"). A newer reference would not load in an older compiler (CS9057). The reference is compile-only: the compiler
    provides that API, and the package takes no dependency on it.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Tisilia.AspNetCore.SourceGenerator</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <!-- the generator's tests drive it directly -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tisilia.Contract.Tests" />
  </ItemGroup>

</Project>
