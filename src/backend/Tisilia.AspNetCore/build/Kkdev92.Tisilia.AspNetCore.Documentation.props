<Project>
  <!--
    The XML documentation file: /// comments reach the contract (and from there the Explorer and the generated client) only through
    the file the compiler writes next to the assembly. The .NET SDK imports this file after the project file and before it resolves
    GenerateDocumentationFile (Sdk.targets imports $(BeforeMicrosoftNETSdkTargets) ahead of Microsoft.NET.Sdk.BeforeCommon.targets;
    Kkdev92.Tisilia.AspNetCore.props adds this file to it), so it sees what the project decided:

    - a project that sets GenerateDocumentationFile or DocumentationFile itself (project file, Directory.Build.props) keeps its own
      settings and the compiler's warnings as they are;
    - otherwise the documentation file is turned on, and the build reports what it did before: the warnings for comments that are
      missing are off, and those for comments that are malformed (they also keep the text out of the contract) stay warnings, never
      errors under TreatWarningsAsErrors.
  -->
  <PropertyGroup Condition="'$(GenerateDocumentationFile)' == '' and '$(DocumentationFile)' == ''">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- missing: a comment on a public type or member (CS1591), a param or typeparam tag beside documented ones (CS1573, CS1712) -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1712</NoWarn>
    <!-- malformed: XML (CS1570, CS1592), cref (CS0419, CS1574, CS1580, CS1581, CS1584, CS1658, CS1723, CS8018), param and typeparam
         names (CS1571, CS1572, CS1710, CS1711, CS1734, CS1735), placement (CS1587), include (CS1589, CS1590) -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0419;CS1570;CS1571;CS1572;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1592;CS1658;CS1710;CS1711;CS1723;CS1734;CS1735;CS8018</WarningsNotAsErrors>
    <_TisiliaTurnedOnDocumentationFile>true</_TisiliaTurnedOnDocumentationFile>
  </PropertyGroup>
</Project>
