<?xml version="1.0" encoding="utf-8"?>
<!-- https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids -->
<!--
  Binary breaks against 0.1.0-alpha that 0.2.0-alpha accepts (the changelog's 0.2.0-alpha Compatibility): these members gained
  optional parameters, so calls compile unchanged, but an assembly compiled against 0.1.0-alpha has to be rebuilt. Delete this
  file in the version bump that moves PackageValidationBaselineVersion past 0.1.0-alpha: against a newer baseline the
  suppressions match nothing, and pack fails until they go.
-->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Tisilia.AspNetCore.Export.ClrTypeMapper.#ctor(Tisilia.Generator.Building.ContractBuilder,Tisilia.AspNetCore.Export.ProfileContext,Tisilia.AspNetCore.TisiliaOptions,Tisilia.Generator.Diagnostics.DiagnosticBag,Tisilia.AspNetCore.Conformance.RunnerAdapterTable)</Target>
    <Left>lib/net10.0/Tisilia.AspNetCore.dll</Left>
    <Right>lib/net10.0/Tisilia.AspNetCore.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Tisilia.AspNetCore.Export.TisiliaContractExporter.Diagnose</Target>
    <Left>lib/net10.0/Tisilia.AspNetCore.dll</Left>
    <Right>lib/net10.0/Tisilia.AspNetCore.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
</Suppressions>
