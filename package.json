{
  "name": "tisilia-workspace",
  "private": true,
  "version": "0.2.0-alpha",
  "description": "Tisilia workspace: runtime, Nuxt integration and Explorer packages (TypeScript 6 / Node 24).",
  "type": "module",
  "workspaces": [
    "src/frontend/runtime",
    "src/frontend/nuxt",
    "src/frontend/explorer"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "brand:sync": "node scripts/sync-brand-assets.mjs",
    "brand:check": "node scripts/sync-brand-assets.mjs --check",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
